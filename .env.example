# ==============================================================================
# Ngaoundéré FC — Variables d'environnement (nfcwebsite)
# Ne JAMAIS committer de vraies valeurs. Copier vers .env.local en développement
# et renseigner les variables dans Project Settings > Environment Variables sur Vercel.
# ==============================================================================

# PostgreSQL / Supabase (utilisé au runtime et pour `prisma migrate deploy`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optionnel : connexion directe séparée si DATABASE_URL passe par un pooler de transactions.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Authentification JWT (obligatoire en production ; générer avec `openssl rand -base64 48`, 2 secrets distincts).
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-second-distinct-random-secret-at-least-32-chars"

# Domaine public canonique et URL du formulaire de réinitialisation de mot de passe (optionnelle).
NEXT_PUBLIC_SITE_URL="https://www.ngaounderefc.cm"
PASSWORD_RESET_URL="https://manager.ngaounderefc.cm/mot-de-passe/reinitialiser"

# Cloudinary (côté serveur uniquement — ne JAMAIS préfixer par NEXT_PUBLIC_).
# SÉCURITÉ : des clés Cloudinary ont été exposées dans l'historique Git antérieur.
# Régénérez impérativement la paire API Key / API Secret dans la console Cloudinary
# (Settings > Access Keys) et supprimez l'ancienne clé avant la mise en production.
# Vous pouvez définir SOIT `CLOUDINARY_URL`, SOIT les 3 variables séparées :
CLOUDINARY_URL="cloudinary://YOUR_REGENERATED_API_KEY:YOUR_REGENERATED_API_SECRET@YOUR_CLOUD_NAME"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-regenerated-api-key"
CLOUDINARY_API_SECRET="your-regenerated-api-secret"

# E-mails transactionnels Resend (réinitialisation de mot de passe, invitations, /api/emails).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
DEFAULT_FROM_EMAIL="Ngaoundéré FC <no-reply@ngaounderefc.cm>"
CONTACT_EMAIL="contact@ngaounderefc.cm"

# Notifications Web Push VAPID (optionnel : laisser PUSH_NOTIFICATIONS_ENABLED="false" pour désactiver).
# Générer une paire avec : npx web-push generate-vapid-keys
PUSH_NOTIFICATIONS_ENABLED="false"
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:contact@ngaounderefc.cm"

# Liens publics de secours (les valeurs en base via ClubSetting / /api/settings sont prioritaires).
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/your-page"
NEXT_PUBLIC_WHATSAPP_PARTENAIRE="237600000000"
NEXT_PUBLIC_WHATSAPP_BILLETTERIE="237600000000"
