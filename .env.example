# PostgreSQL / Supabase: transaction pooler for Vercel runtime.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler or direct database URL for Prisma migrations.
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Authentication (use long, random secrets; never commit real values).
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Canonical public domain.
NEXT_PUBLIC_SITE_URL="https://ngaounderefc.cm"

# Cloudinary (server-only credentials).
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# Optional public links and contact configuration.
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_WHATSAPP_PARTENAIRE=""
NEXT_PUBLIC_WHATSAPP_BILLETTERIE=""

# Email service.
RESEND_API_KEY="replace-me"
CONTACT_EMAIL="contact@ngaounderefc.cm"
