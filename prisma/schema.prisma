generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles      Article[]
  uploadedMedia Media[]
}

model Media {
  id         String   @id @default(uuid())
  provider   String
  publicId   String   @unique
  url        String
  mimeType   String
  width      Int?
  height     Int?
  size       Int?
  variants   Json?
  altText    String?
  uploadedById String?
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])
  coverOf    Article[]
  createdAt  DateTime @default(now())
}

model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  summary     String?
  content     String
  coverId     String?
  cover       Media?    @relation(fields: [coverId], references: [id])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Player {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  number     Int?
  position   String?
  nationality String?
  bio        String?
  photoId    String?
  stats      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Match {
  id         String   @id @default(uuid())
  date       DateTime
  homeTeam   String
  awayTeam   String
  homeScore  Int?
  awayScore  Int?
  events     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sponsor {
  id       String   @id @default(uuid())
  name     String
  link     String?
  logoId   String?
  priority Int      @default(0)
}

model FormSubmission {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  ip        String?
  userAgent String?
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  from      String
  subject   String
  body      String
  provider  String
  providerId String?
  status    String
  createdAt DateTime @default(now())
}
