generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================================
// Énumération des rôles utilisateurs
// ===================================
enum UserRole {
  ADMIN
  EDITOR
  USER
}

// ===================================
// Utilisateur / Admin
// ===================================
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles      Article[]
  uploadedMedia Media[]
}

model Season {
  id        String     @id @default(uuid())
  label     String     @unique
  startsAt  DateTime
  endsAt    DateTime
  isCurrent Boolean    @default(false)
  standings Standing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Team {
  id        String     @id @default(uuid())
  name      String     @unique
  logoUrl   String?
  standings Standing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Standing {
  id            String   @id @default(uuid())
  seasonId      String
  teamId        String
  played        Int      @default(0)
  won           Int      @default(0)
  drawn         Int      @default(0)
  lost          Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  points        Int      @default(0)
  form          String?
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId, points])
}

// ===================================
// Média (Image / Vidéo) avec association joueur optionnelle
// ===================================
model Media {
  id           String   @id @default(uuid())
  provider     String
  publicId     String   @unique
  url          String
  mimeType     String
  width        Int?
  height       Int?
  size         Int?
  variants     Json?
  altText      String?
  album        String?     // Album galerie (ex: "Entraînements", "Saison 2025-2026")
  title        String?     // Titre de l'asset
  mediaType    String?     // "IMAGE" ou "VIDEO"
  // Association optionnelle à un joueur (pour la page détail joueur)
  playerId     String?
  player       Player?     @relation(fields: [playerId], references: [id])
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id])
  coverOf      Article[]
  createdAt    DateTime    @default(now())
}

// ===================================
// Article / Actualité
// ===================================
model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  summary     String?
  content     String
  coverId     String?
  cover       Media?    @relation(fields: [coverId], references: [id])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  category    String?
  videoUrl    String?   // URL de la vidéo associée à l'article (YouTube, Vimeo, etc.)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===================================
// Joueur
// ===================================
model Player {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  number       Int?
  position     String?  // GARDIEN | DEFENSEUR | MILIEU | ATTAQUANT
  nationality  String?
  bio          String?
  photoId      String?
  stats        Json?
  isCaptain    Boolean  @default(false)
  birthDate    String?
  height       Int?
  weight       Int?
  joinedYear   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Médias associés à ce joueur (galerie spécifique joueur)
  media        Media[]
}

// ===================================
// Match
// ===================================
model Match {
  id          String   @id @default(uuid())
  date        DateTime
  homeTeam    String
  awayTeam    String
  homeScore   Int?
  awayScore   Int?
  stadium     String?
  competition String?
  status      String   @default("PROGRAMME") // PROGRAMME | EN_COURS | TERMINE | REPORTE
  summary     String?
  events      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================================
// Sponsor / Partenaire
// ===================================
model Sponsor {
  id       String   @id @default(uuid())
  name     String
  link     String?
  logoId   String?
  priority Int      @default(0)
}

// ===================================
// Soumission de formulaire (académie, contact, newsletter, etc.)
// ===================================
model FormSubmission {
  id        String   @id @default(uuid())
  type      String   // "ACADEMIE" | "NEWSLETTER" | "CONTACT" | "BILLETTERIE"
  payload   Json     // Données complètes du formulaire (nom, email, besoins, etc.)
  ip        String?
  userAgent String?
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===================================
// Abonné Newsletter (emails stockés séparément pour facilité)
// ===================================
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===================================
// Log d'email envoyé
// ===================================
model EmailLog {
  id         String   @id @default(uuid())
  to         String
  from       String
  subject    String
  body       String
  provider   String
  providerId String?
  status     String
  createdAt  DateTime @default(now())
}
